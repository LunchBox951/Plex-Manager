# Plex Manager Environment Configuration
# Copy this file to .env and fill in your values

# JWT Secret Key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your-secret-key-change-this-in-production

# Plex OAuth Client ID (generate with: python -c "import uuid; print(str(uuid.uuid4()))")
PLEX_CLIENT_ID=your-plex-client-id-uuid

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./data/plex_manager.db

# Plex Configuration
PLEX_URL=http://YOUR_PLEX_SERVER_IP:32400
PLEX_TOKEN=YOUR_PLEX_TOKEN

# TMDB API Configuration
TMDB_API_KEY=YOUR_TMDB_API_KEY

# Encryption Key for Plex tokens (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-fernet-encryption-key

# Environment (development or production)
ENV=development
